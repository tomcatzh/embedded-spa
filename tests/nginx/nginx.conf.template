worker_processes 1;
error_log /dev/stderr notice;
pid /tmp/nginx.pid;

events {
    worker_connections 128;
}

http {
    access_log /dev/stdout combined;

    proxy_cache_path /var/cache/nginx/embedded-spa-test
        levels=1:2
        keys_zone=embedded_spa_test:4m
        max_size=32m
        inactive=5m
        use_temp_path=off;

    server {
        listen 8080;
        server_name _;

        location ^~ /_test/ {
            proxy_pass http://host.docker.internal:__ORIGIN_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_cache off;
        }

        location / {
            proxy_pass http://host.docker.internal:__ORIGIN_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host $host;

            # Rust serves final precompressed representations and validators.
            gzip off;

            proxy_cache embedded_spa_test;
            proxy_cache_revalidate on;
            proxy_cache_lock on;
            proxy_cache_use_stale error timeout updating
                http_500 http_502 http_503 http_504;

            add_header X-Cache-Status $upstream_cache_status always;
        }
    }
}
